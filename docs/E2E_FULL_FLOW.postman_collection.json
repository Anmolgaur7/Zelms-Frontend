      ]
    },
    {
      "name": "5 — SOPs & quizzes",
      "description": "**5.5** AI study materials (`GET .../sops/:id/study`). **5.6** SOP chat (`POST .../sops/:id/chat`). Need **`sopId`** from **5.2** and a valid **`companyToken`**.",
      "item": [
        {
          "name": "5.1 List SOPs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sops/"
          }
        },
        {
          "name": "5.2 Upload SOP (PDF file + form fields)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/sops/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "type": "text",
                  "value": "E2E GMP SOP"
                },
                {
                  "key": "version",
                  "type": "text",
                  "value": "1.0"
                },
                {
                  "key": "category",
                  "type": "text",
                  "value": "E2E"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Attach a real PDF (required)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.sopId) pm.collectionVariables.set(\"sopId\", d.sopId);"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Get quizzes for SOP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quizzes/sop/{{sopId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const quizzes = pm.response.json();",
                  "if (!Array.isArray(quizzes) || quizzes.length < 1) {",
                  "  console.warn(\"No quizzes: fix SOP upload or AI keys\");",
                  "  return;",
                  "}",
                  "const quiz = quizzes[0];",
                  "pm.collectionVariables.set(\"quizId\", quiz.id);",
                  "const questions = quiz.questions || [];",
                  "const answers = questions.map((q, i) => ({ questionIndex: i, selectedAnswer: q.correctAnswer }));",
                  "pm.collectionVariables.set(\"quizSubmitPayload\", JSON.stringify({",
                  "  answers,",
                  "  signature: { value: \"E2E Tester\", meaning: \"Attest quiz completion\" }",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Create manual quiz (optional extra quiz)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quizzes/manual",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sopId\": \"{{sopId}}\",\n  \"difficulty\": \"BASIC\",\n  \"questions\": [\n    {\n      \"question\": \"E2E sample: 2+2=?\",\n      \"options\": [\n        \"3\",\n        \"4\",\n        \"5\",\n        \"22\"\n      ],\n      \"correctAnswer\": \"4\",\n      \"explanation\": \"Arithmetic\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5.5 GET study materials (AI summary / flashcards)",
          "request": {
            "description": "`GET /api/sops/:sopId/study` — returns JSON (cached in `studyMaterials` or AI-generated). Requires AI/storage working for cache miss.",
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/sops/{{sopId}}/study"
          }
        },
        {
          "name": "5.6 POST SOP chat (AI assistant)",
          "request": {
            "description": "`POST /api/sops/:sopId/chat` — body `{ \"question\": \"...\" }`; response `{ \"answer\": \"...\" }`.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sops/{{sopId}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the main purpose of this SOP?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "6 — Assignments & training",
      "description": "**6.2** login → `mustChangePassword: true`. **6.3** change password → new `token`. **6.6** submit quiz — body built from **5.3** Tests script (`quizSubmitPayload`).",
      "item": [
        {
          "name": "6.1 Assign quiz to invited user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assignments/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{invitedUserId}}\",\n  \"quizId\": \"{{quizId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6.2 Employee login (temporary password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization\": \"{{e2ePrefix}}\",\n  \"employeeId\": \"{{invitedEmployeeId}}\",\n  \"password\": \"{{employeeTempPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set(\"employeeToken\", d.token);",
                  "pm.test(\"must change password after invite\", function () {",
                  "  pm.expect(d.mustChangePassword).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Change password (first login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{employeeTempPassword}}\",\n  \"newPassword\": \"Employee@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set(\"employeeToken\", d.token);",
                  "pm.test(\"password change returns fresh token\", function () {",
                  "  pm.expect(d.mustChangePassword).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 My assignments",
