      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "e2ePrefix",
      "value": "",
      "description": "Auto-set on 1.2 Send if empty; if you set prefix+email yourself, prerequest leaves them unchanged."
    },
    {
      "key": "e2eAdminEmail",
      "value": "",
      "description": "Auto-set on 1.2 Send if empty; if you set prefix+email yourself, prerequest leaves them unchanged."
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
