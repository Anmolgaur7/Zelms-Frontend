                  "const arr = pm.response.json();",
                  "const qid = pm.collectionVariables.get(\"quizId\");",
                  "const a = Array.isArray(arr) ? arr.find((x) => x.quizId === qid) || arr[0] : null;",
                  "if (a && a.id) pm.collectionVariables.set(\"assignmentId\", a.id);"
                ]
              }
            }
