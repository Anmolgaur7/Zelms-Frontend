    }
  ],
  "item": [
    {
      "name": "0 — System",
      "description": "**GET** health / ready / root — no auth. Expect `{ status }` or `{ status, checks }`.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Ready (database)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          }
        },
        {
          "name": "API root",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "1 — Platform",
      "description": "**1.1** `200` → `{ token, role, name }`. **1.2** `201` onboard → `{ companyId, superAdminId, licenseId, inviteLink, ... }`; Tests save `verificationToken` from `inviteLink`.",
      "item": [
        {
          "name": "1.1 Platform login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/platform/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"master@pharmalearn.com\",\n  \"password\": \"platform123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set(\"platformToken\", d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Onboard company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{platformToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/platform/onboard",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"E2E Demo Pharma\",\n  \"employeeIdPrefix\": \"{{e2ePrefix}}\",\n  \"adminName\": \"E2E Super Admin\",\n  \"adminEmail\": \"{{e2eAdminEmail}}\",\n  \"reason\": \"Postman end-to-end verification of onboarding and training flow\",\n  \"logoUrl\": \"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7f/Replacement_character.svg/120px-Replacement_character.svg.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// If e2ePrefix + e2eAdminEmail are already set, keep them (no overwrite on Send).",
                  "const pref = (pm.collectionVariables.get(\"e2ePrefix\") || \"\").trim();",
                  "const adm = (pm.collectionVariables.get(\"e2eAdminEmail\") || \"\").trim();",
                  "if (pref && adm) { return; }",
                  "const t = Date.now();",
                  "const p = (\"E\" + t.toString(36).toUpperCase()).slice(0, 10);",
                  "pm.collectionVariables.set(\"e2ePrefix\", p);",
                  "pm.collectionVariables.set(\"e2eAdminEmail\", \"emp.admin.\" + t + \"@e2e.example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.inviteLink) {",
                  "  const m = String(d.inviteLink).match(/token=([a-f0-9-]+)/i);",
                  "  if (m) pm.collectionVariables.set(\"verificationToken\", m[1]);",
                  "}",
                  "if (d.licenseId) console.log(\"Assigned licenseId:\", d.licenseId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
