    {
      "name": "4 — Admin org & users",
      "description": "**4.0** bulk `201` → `{ message, users: [{ employeeId, temporaryPassword }] }`. **4.2** single user same + `userId`. Email optional on API.",
      "item": [
        {
          "name": "4.0 Bulk import — POST /api/admin/users/bulk",
          "request": {
            "description": "Creates multiple users without **email** (line workers). Each row may include **employeeId** (optional): leave **\"\"** for auto `PREFIX-n`; digits only → `PREFIX-digits`; else full ID. Response lists **employeeId** + **temporaryPassword** per row. Optional **email** per user if you want mail later.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/bulk",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"name\": \"E2E Bulk Employee\",\n      \"role\": \"EMPLOYEE\",\n      \"employeeId\": \"\",\n      \"departmentId\": \"{{departmentId}}\"\n    },\n    {\n      \"name\": \"E2E Bulk Trainer\",\n      \"role\": \"TRAINER\",\n      \"employeeId\": \"\"\n    }\n  ],\n  \"reason\": \"Postman E2E bulk import sample run\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4.1 Create department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Production\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set(\"departmentId\", d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Invite employee",
          "request": {
            "description": "**employeeId** (optional): omit → auto `{prefix}-n`; digits only → `{prefix}-digits`; else full ID. **Login:** organization + employeeId + password. **Email** is optional — omit for floor workers; add **email** only if this person should receive system mail.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Line Worker\",\n  \"role\": \"EMPLOYEE\",\n  \"employeeId\": \"{{e2eInviteEmployeeId}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"reason\": \"Postman E2E invite for training assignment flow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.userId) pm.collectionVariables.set(\"invitedUserId\", d.userId);",
                  "if (d.employeeId) pm.collectionVariables.set(\"invitedEmployeeId\", d.employeeId);",
                  "if (d.temporaryPassword) pm.collectionVariables.set(\"employeeTempPassword\", d.temporaryPassword);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 List users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users"
          }
        },
        {
          "name": "4.4 Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/stats"
          }
        },
        {
          "name": "4.5 PATCH employee role → TRAINER (then back)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{invitedUserId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"TRAINER\",\n  \"reason\": \"Postman E2E role change verification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4.6 PATCH role back to EMPLOYEE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{companyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{invitedUserId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"EMPLOYEE\",\n  \"reason\": \"Postman E2E revert role for assignment tests\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
